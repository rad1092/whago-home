{
  "name": "whago-site",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build:static": "WHAGO_STATIC_EXPORT=1 next build",
    "build:server": "npm run build:static",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vinext": "0.2.1",
    "vite": "^8.3.1",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "vinext": {
      "image-size": "2.0.4"
    }
  },
  "type": "module"
}
